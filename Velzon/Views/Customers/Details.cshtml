@model Poc.Infrastructure.DTOs.Customer.CustomerDetailDTO
@{
    ViewBag.Title = "Customer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
   
}


<div class="row">
    <div class="col-xxl-12">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#personalDetails" role="tab">
                            <i class="fas fa-user"></i> Personal Information
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#businessInfo" role="tab">
                            <i class="fas fa-building"></i> Business Information
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#proofOfBusiness" role="tab">
                            <i class="fas fa-file-alt"></i> Proof of Business
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#businessActivities" role="tab">
                            <i class="fas fa-history"></i> Business Activities
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4">
                <div class="tab-content">
                    <!-- Personal Information Tab -->
                    <div class="tab-pane active" id="personalDetails" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">First Name</label>
                                    <p class="form-control-plaintext">@Model.FirstName</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Last Name</label>
                                    <p class="form-control-plaintext">@Model.LastName</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <p class="form-control-plaintext">@Model.Email</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <p class="form-control-plaintext">@Model.Phone</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Mobile</label>
                                    <p class="form-control-plaintext">@Model.Mobile</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Country</label>
                                    <p class="form-control-plaintext">@Model.Country</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">State</label>
                                    <p class="form-control-plaintext">@Model.State</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">City</label>
                                    <p class="form-control-plaintext">@Model.City</p>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <label class="form-label">Address</label>
                                    <p class="form-control-plaintext">@Model.Address</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Business Information Tab -->
                    <div class="tab-pane" id="businessInfo" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Business Type</label>
                                    <p class="form-control-plaintext">@Model.BusinessType</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Business Country</label>
                                    <p class="form-control-plaintext">@Model.BusinessCountry</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Business State</label>
                                    <p class="form-control-plaintext">@Model.BusinessState</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Business City</label>
                                    <p class="form-control-plaintext">@Model.BusinessCity</p>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="mb-3">
                                    <label class="form-label">Business Address</label>
                                    <p class="form-control-plaintext">@Model.BusinessAddress</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Proof of Business Tab -->
    <div class="tab-pane" id="proofOfBusiness" role="tabpanel">
        @if (Model.ProofOfBusinesses != null && Model.ProofOfBusinesses.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-nowrap">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>File</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proof in Model.ProofOfBusinesses)
                        {
                            <tr>
                                <td>@proof.TypeName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(proof.FileContent))
                                    {
                                        var fileUrl = Url.Content($"~/assets/uploads/{proof.FileContent}");
                                        <div>
                                            <a href="@fileUrl" target="_blank" class="btn btn-sm btn-primary">View</a>
                                            <a href="@fileUrl" download class="btn btn-sm btn-success ms-2">Download</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No File</span>
                                    }
                                </td>
                                <td>
                                    <span id="proof-status-@proof.Id.ToString()" class="badge fs-6 @(proof.Status == true
            ? "bg-success"
            : proof.Status == false
                ? "bg-danger"
                : "bg-secondary")">
                                        @(proof.Status == true ? "Approved"
                                            : proof.Status == false ? "Rejected"
                                            : "Pending")
                                    </span>

                                    @* ✅ Tick/ Cross buttons if Pending *@
                                    @if (proof.Status == null)
                                    {
                                        <button class="btn btn-sm btn-light ms-1 proof-action-btn"
                                                data-id="@proof.Id" data-status="true" title="Approve">
                                            <i class="mdi mdi-checkbox-marked-outline"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light ms-1 proof-action-btn"
                                                data-id="@proof.Id" data-status="false" title="Reject">
                                            <i class="mdi mdi-window-close"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No Proof of Business available.</p>
        }
    </div>

                       
                    <!-- Business Activities Tab -->
                    <div class="tab-pane" id="businessActivities" role="tabpanel">
                        @if (Model.ProofOfBusinessesActivity != null && Model.ProofOfBusinessesActivity.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-nowrap">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Type</th>
                            <th>Reason</th>
                                            <th>Status</th>
                                                              
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var activity in Model.ProofOfBusinessesActivity)
                                        {
                                            <tr>
                                                <td>@activity.TypeName</td>
                                                <td>@activity.Reason</td>
                                <td>
                                    <span id="proof-status-@activity.Id"
                                            class="badge fs-6 @(activity.Status == true
                                                ? "bg-success"
                                                : activity.Status == false
                                                    ? "bg-danger"
                                                    : "bg-secondary")">
                                        @(activity.Status == true
                                            ? "Approved"
                                            : activity.Status == false
                                            ? "Rejected"
                                            : "Pending")
                                    </span>
                                </td>
                                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No Proof of Business Activities available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    <!-- Proof of Business Modal -->
    <div class="modal fade" id="proofActivityModal" tabindex="-1" aria-labelledby="proofActivityModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="proofActivityModalLabel">Provide Reason</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modal-proof-id" />
                    <input type="hidden" id="modal-status" />
                    <div class="mb-3">
                        <label for="modal-reason" class="form-label">Reason</label>
                        <textarea id="modal-reason" class="form-control" rows="4" placeholder="Enter reason here..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="modal-submit" class="btn btn-success">Submit</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = new bootstrap.Modal(document.getElementById('proofActivityModal'));

            // ✅ Tick/ Cross click open modal
            document.querySelectorAll(".proof-action-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    let proofId = this.getAttribute("data-id");
                    let status = this.getAttribute("data-status");

                    document.getElementById("modal-proof-id").value = proofId;
                    document.getElementById("modal-status").value = status;
                    document.getElementById("modal-reason").value = "";

                    modal.show();
                });
            });

            // ✅ Submit modal
            document.getElementById("modal-submit").addEventListener("click", function (e) {
                e.preventDefault();

                let proofId = document.getElementById("modal-proof-id").value;
                let status = document.getElementById("modal-status").value === "true";
                let reason = document.getElementById("modal-reason").value.trim();

                if (!reason) {
                    Swal.fire("Error!", "Please enter a reason", "error");
                    return;
                }

                fetch('/Customers/AddProofActivity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Id: proofId, Status: status, Reason: reason })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        // ✅ Update badge
                        let badge = document.getElementById("proof-status-" + proofId);
                        if (badge) {
                            badge.textContent = status ? "Approved" : "Rejected";

                            badge.classList.remove("bg-success","bg-danger","bg-secondary");
                            badge.classList.add(status ? "bg-success" : "bg-danger");
                        }

                        // ✅ Remove tick/cross buttons
                        let row = badge.closest("tr");
                        if(row){
                            row.querySelectorAll(".proof-action-btn").forEach(b => b.remove());
                        }

                        modal.hide();
                        Swal.fire("Done!", "Status updated successfully.", "success");
                    } else {
                        Swal.fire("Error!", data.message || "Update failed", "error");
                    }
                })
                .catch(err => {
                    Swal.fire("Error!", "Request failed: " + err.message, "error");
                });
            });
        });
    </script>




