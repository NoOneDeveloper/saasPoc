@{
    ViewBag.Title = "Reset Password";
    Layout = null;
}

<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg" data-theme="galaxy" data-theme-colors="green">
<head>
    @Html.Partial("~/Views/Shared/_title_meta.cshtml")
    @Html.Partial("~/Views/Shared/_head_css.cshtml")
</head>
<body>

    <div class="auth-page-wrapper pt-5">
        <!-- background -->
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div class="bg-overlay"></div>
        </div>

        <!-- content -->
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center mt-sm-5 mb-4 text-white-50">
                        <a href="@Url.Action("Index", "Dashboard")" class="d-inline-block auth-logo">
                            <img src="~/assets/images/logo-light.png" alt="">
                        </a>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6 col-xl-5">
                        <div class="card mt-4 card-bg-fill glass-card">

                            <div class="card-body p-4">
                                <div class="text-center mt-2 signup-header">
                                    <h1 class="text-white">
                                        <i class="fas fa-unlock-alt"></i> Reset Password
                                    </h1>
                      
                                    <!-- Improved animated icon -->
                                    <lord-icon src="https://cdn.lordicon.com/rhvddzym.json"
                                               trigger="loop"
                                               delay="2000"
                                               colors="primary:#4e73df,secondary:#1cc88a"
                                               style="width:70px;height:70px">
                                    </lord-icon>

                                </div>

                                <div class="alert border-0 alert-info text-center mb-3 mx-2 text-white" role="alert">
                                    Enter your email and we’ll send instruction!
                                </div>

                                <div class="p-2 mt-3">
                                    <form method="post" action="@Url.Action("PasswordResetBasic", "Authentication")">
                                        <div class="mb-3">
                                            <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control" id="email" name="Email" placeholder="Enter your email" required>
                                        </div>

                                        <div class="mt-4">
                                            <button class="btn btn-gold w-100" type="submit">Send Reset Link</button>
                                        </div>

                                        <div class="mt-4 text-center switch-link">
                                            <p class="mb-0">
                                                Remembered your password?
                                                <a href="@Url.Action("SignIn", "Authentication")"> Sign In </a>
                                            </p>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <!-- end card-body -->
                        </div>
                        <!-- end card -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/_vendor_scripts.cshtml")

    <!-- particles js -->
    <script src="~/assets/libs/particles.js/particles.js"></script>
    <script src="~/assets/js/pages/particles.app.js"></script>

</body>
</html>
