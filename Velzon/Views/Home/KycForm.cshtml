@using Poc.Infrastructure.DTOs
@model CustomerDTO



@{
    ViewBag.Title = "Wizard";
    ViewBag.pTitle = "Wizard";
    ViewBag.pageTitle = "Forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card">
            <div class="card-body">
                <form action="#" class="form-steps" autocomplete="off">
                    <div class="text-center pt-3 pb-4 mb-1 d-flex justify-content-center">
                        <img src="~/assets/images/logo-dark.png" class="card-logo card-logo-dark" alt="logo dark">
                        <img src="~/assets/images/logo-light.png" class="card-logo card-logo-light" alt="logo light">
                    </div>
                    <div class="step-arrow-nav mb-4">
                        <ul class="nav nav-pills custom-nav nav-justified" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="steparrow-gen-info-tab" data-bs-toggle="pill" data-bs-target="#steparrow-gen-info" type="button" role="tab" aria-controls="steparrow-gen-info" aria-selected="true">Personal</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="steparrow-description-info-tab" data-bs-toggle="pill" data-bs-target="#steparrow-description-info" type="button" role="tab" aria-controls="steparrow-description-info" aria-selected="false">Description</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="pills-experience-tab" data-bs-toggle="pill" data-bs-target="#pills-experience" type="button" role="tab" aria-controls="pills-experience" aria-selected="false">Finish</button>
                            </li>
                        </ul>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="steparrow-gen-info" role="tabpanel" aria-labelledby="steparrow-gen-info-tab">
                            <div>
                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="mb-3 ">
                                            <label class="form-label" for="steparrow-gen-info-username-input">First Name</label>
                                            <input type="text" class="form-control" asp-for="FirstName" id="steparrow-gen-info-username-input" placeholder="@Model.FirstName" readonly>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 ">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-email-input">Last Name</label>
                                            <input type="text" class="form-control" asp-for="LastName" id="steparrow-gen-info-email-input" placeholder="@Model.LastName" readonly>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Email</label>
                                            <input type="text" class="form-control" asp-for="Email" id="steparrow-gen-info-username-input" placeholder="@Model.Email" readonly>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Phone</label>
                                            <input type="text" class="form-control" asp-for="Phone" id="steparrow-gen-info-username-input" placeholder="@Model.Phone" readonly>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Mobile Number</label>
                                            <input type="text" class="form-control" asp-for="Mobile" id="steparrow-gen-info-username-input" placeholder="Enter user name" >
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Country</label>
                                            <input type="text" class="form-control" asp-for="Country" id="steparrow-gen-info-username-input" placeholder="Enter your Country" >
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">State</label>
                                            <input type="text" class="form-control" asp-for="State" id="steparrow-gen-info-username-input" placeholder="Enter Your State">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">City</label>
                                            <input type="text" class="form-control" asp-for="City" id="steparrow-gen-info-username-input" placeholder="Enter Your City">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Address</label>
                                            <input type="text" class="form-control" asp-for="Address" id="steparrow-gen-info-username-input" placeholder="Enter Your Address">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3 mt-4">
                                <button type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="steparrow-description-info-tab"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Go to more info</button>
                            </div>
                        </div>
                        <!-- end tab pane -->

                        <div class="tab-pane fade" id="steparrow-description-info" role="tabpanel" aria-labelledby="steparrow-description-info-tab">
                            <div>
                                <div class="row">
                                    <div class="mb-3">
                                        <label class="form-label" for="steparrow-gen-info-username-input">Business</label>
                                        <input type="text" class="form-control" asp-for="BusinessType" id="steparrow-gen-info-username-input" placeholder="Enter Your Business Type">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="my-3">
                                        <h5> Business Address</h5>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Country</label>
                                            <input type="text" class="form-control" asp-for="BusinessCountry" id="steparrow-gen-info-username-input" placeholder="Enter your Country">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input"> State</label>
                                            <input type="text" class="form-control" asp-for="BusinessState" id="steparrow-gen-info-username-input" placeholder="Enter Your State">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">City</label>
                                            <input type="text" class="form-control" asp-for="BusinessCity" id="steparrow-gen-info-username-input" placeholder="Enter Your City">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Address</label>
                                            <input type="text" class="form-control" asp-for="BusinessAddress" id="steparrow-gen-info-username-input" placeholder="Enter Your Address">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="my-3">
                                        <h5>Business Proof Documents</h5>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Certificate of Incorporation / Registration</label>
                                            <input type="file" class="form-control" asp-for="RegistrationFileContent" id="steparrow-gen-info-username-input" placeholder="Upload document">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input"> Memorandum & Articles of Association</label>
                                            <input type="file" class="form-control" asp-for="MemorandumFileContent" id="steparrow-gen-info-username-input" placeholder="Upload document">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Business / Trade License</label>
                                            <input type="file" class="form-control" asp-for="LicenseFileContent" id="steparrow-gen-info-username-input" placeholder="Upload document">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="steparrow-gen-info-username-input">Tax Identification Number</label>
                                            <input type="file" class="form-control" asp-for="TaxFileContent" id="steparrow-gen-info-username-input" placeholder="Upload document">
                                        </div>
                                    </div>
                                </div>                               
                            </div>
                            <div class="d-flex align-items-start gap-3 mt-4">
                                <button type="button" class="btn btn-light btn-label previestab" data-previous="steparrow-gen-info-tab"><i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i> Back to General</button>
                                <button type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="pills-experience-tab"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Submit</button>
                            </div>
                        </div>
                        <!-- end tab pane -->

                        <div class="tab-pane fade" id="pills-experience" role="tabpanel">
                            <div class="text-center">

                                <div class="avatar-md mt-5 mb-4 mx-auto">
                                    <div class="avatar-title bg-light text-success display-4 rounded-circle">
                                        <i class="ri-checkbox-circle-fill"></i>
                                    </div>
                                </div>
                                <h5>Well Done !</h5>
                                <p class="text-muted">You have Successfully Signed Up</p>
                            </div>
                        </div>
                        <!-- end tab pane -->
                    </div>
                    <!-- end tab content -->
                </form>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
</div>

@section scripts {
    <!-- form wizard init -->
    <script src="~/assets/js/pages/form-wizard.init.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}