                <div class="text-center my-3">
                    <img src="@Url.Content("~/assets/images/logo-sm.png")" alt="Logo" height="50" />
                </div>
        </div>
        
        <!-- Result Content -->
        <div class="text-center mt-5">
            <!-- Error Icon -->
            <div class="mb-3">
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="30" cy="30" r="28" stroke="#c62828" stroke-width="4" fill="none" />
