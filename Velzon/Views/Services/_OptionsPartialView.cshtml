@* Views/Services/OptionsPartialView.cshtml *@
<div class="payment-container" style="text-align:center; padding:20px; background:#f0f3fa;">
    <!-- Logo Section -->
    <div style="margin-bottom:20px;">
@*         <img src="~/images/logo.png" alt="Logo" style="height:60px;" /> *@
         <img src="~/assets/images/logo-light.png" alt="" height="50">
    </div>

    <!-- Payment Options -->
    <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap;">
        <div style="background:#007bff; color:#fff; padding:20px; border-radius:10px; width:220px;">
            <div style="font-size:24px;">🖱️</div>
            <h3>Click to Pay</h3>
            <p>Customers choose from multiple payment options via a payment link</p>
        </div>

        <div style="background:#007bff; color:#fff; padding:20px; border-radius:10px; width:220px;">
            <div style="font-size:24px;">⌨️</div>
            <h3>Key to Pay</h3>
            <p>Customers pay by card using their phone keypad</p>
        </div>

        <div style="background:#007bff; color:#fff; padding:20px; border-radius:10px; width:220px;">
            <div style="font-size:24px;">🎤</div>
            <h3>Speak to Pay</h3>
            <p>Customers pay by card speaking their card details</p>
        </div>
    </div>

    <!-- More Button -->
    <div style="margin-top:20px; display:flex; justify-content:flex-end;">
        <button id="nextBtn"
                style="padding:10px 20px; border-radius:8px; border:none; background:#fff; color:#007bff; font-weight:bold; box-shadow:0 2px 5px rgba(0,0,0,0.2); cursor:pointer;">
            Next
        </button>
    </div>

</div>
