<div class="row">
    <div class="col-xxl-6 offset-xxl-3">
        <div class="card">
            @* Views/Services/OptionsPartialView.cshtml *@
            <div class="p-4">
                <!-- Logo Section -->
                <div class="my-2 text-center">
                    <img src="~/assets/images/logo-light.png" alt="Logo" height="50">
                </div>
            </div>
        </div>
        <div class="card">
            <div class="p-4">
                <!-- Payment Options -->
                <div class="row justify-content-center g-3">
                    <div class="col-4">
                        <div class="bg-secondary text-white p-3 rounded h-100 text-center">
                            <div>
                                <i class="mdi mdi-cursor-pointer fs-1"></i>
                            </div>
                            <h5 class="mt-2  text-white">Click to Pay</h5>
                            <p class="mb-0">Customers choose from multiple payment options via a payment link</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-secondary text-white p-3 rounded h-100 text-center">
                            <div>
                                <i class="mdi mdi-keyboard-variant fs-1"></i>
                            </div>
                            <h5 class="mt-2  text-white">Key to Pay</h5>
                            <p class="mb-0">Customers pay by card using their phone keypad</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-secondary text-white p-3 rounded h-100 text-center">
                            <div>
								<i class="mdi mdi-microphone fs-1"></i>
                            </div>
                            <h5 class="mt-2  text-white">Speak to Pay</h5>
                            <p class="mb-0">Customers pay by card speaking their card details</p>
                        </div>
                    </div>
                </div>

                <!-- More Button -->
                <div class=" mt-3 d-flex justify-content-end">
                    <button id="nextBtn" class="btn btn-success fw-bold shadow-sm">
                        Next
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
