@* Partial View: Payment Method *@
<div class="payment-container"
     style="max-width:400px; margin:0 auto; font-family:Arial, sans-serif;
            border:1px solid #ccc; border-radius:12px; padding:20px; box-shadow:0 2px 6px rgba(0,0,0,0.1);">

    <!-- Logo Section -->
    <div style="text-align:center; margin-bottom:20px;">
        <img src="~/assets/images/logo-light.png" alt="" height="50">

        <!-- Company & Amount in one line -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
            <p style="margin:0; font-weight:bold;">ACME</p>
            <p style="margin:0; font-size:18px; font-weight:bold;">£12.00</p>
        </div>
    </div>

    <!-- Payment Options -->
    <div>
        <div style="border:1px solid #ccc; border-radius:8px; padding:15px; margin-bottom:15px; cursor:pointer;">
            <span style="font-weight:bold;">
                <i class="fa fa-credit-card"></i> Pay By Card
            </span>
            <p style="margin:5px 0; font-size:13px; color:#555;">
                Use a credit or debit card for a secure, hassle free payment
            </p>
        </div>

        <div style="border:1px solid #ccc; border-radius:8px; padding:15px; margin-bottom:15px; cursor:pointer;">
            <span style="font-weight:bold;">
                <i class="fa fa-university"></i> Pay By Bank
            </span>
            <p style="margin:5px 0; font-size:13px; color:#555;">
                Use your banking app for a secure payment, directly from your account
            </p>
        </div>
    </div>


    <!-- Checkout Button -->
    <div style="text-align:center; margin-top:20px;">
        <button 
             disabled   style="width:100%; padding:12px; border:none; border-radius:8px; background:#007bff; color:#fff; font-weight:bold; cursor:pointer;">
            <i class="fa fa-lock"></i> CONTINUE
        </button>
    </div>
 
</div>
<div style="margin-top:20px; display:flex; justify-content:flex-end;">
    <button id="paymentNextBtn"
            style="padding:10px 20px; border-radius:8px; border:none; background:#fff; color:#007bff; font-weight:bold; box-shadow:0 2px 5px rgba(0,0,0,0.2); cursor:pointer;">
        Next
    </button>
</div>