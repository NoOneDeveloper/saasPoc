@section scripts {
    <!-- form wizard init -->

    <script src="~/assets/js/pages/form-wizard.init.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>

    <script>

        $.validator.addMethod('allowedextensionsandsize', function (value, element, params) {
            if (element.files.length > 0) {
                var file = element.files[0];

                // Allowed extensions
                var extensions = params.extensions.split(',').map(x => x.trim().toLowerCase());
                var ext = value.substr(value.lastIndexOf('.')).toLowerCase();
                if (!extensions.includes(ext)) {
                    return false;
                }

                // File size check
                var maxSize = parseInt(params.maxsize); // in bytes
                if (file.size > maxSize) {
                    return false;
                }
            }
            return true;
        });

        $.validator.unobtrusive.adapters.add(
            'allowedextensionsandsize',
            ['extensions', 'maxsize'],
            function (options) {
                options.rules['allowedextensionsandsize'] = {
                    extensions: options.params.extensions,
                    maxsize: options.params.maxsize
                };
                options.messages['allowedextensionsandsize'] = options.message;
            }
        );


        $(document).ready(function () {
            var form = $("form");

            // ✅ Handle "Next" button (Tab 1 → Tab 2)
            $(".nexttab").click(function (e) {
                var nextTabId = $(this).data("nexttab");

                // Find inputs in current tab
                var currentTabPane = $(this).closest(".tab-pane");
                var inputs = currentTabPane.find("input, select, textarea");

                // Remove ignore so hidden fields won't be skipped
                form.validate().settings.ignore = "";

                // Validate only current tab’s inputs
                if (inputs.length && !inputs.valid()) {
                    e.preventDefault();
                    return false;
                }

                // Move to next tab
                $("#" + nextTabId).tab("show");
            });

            // ✅ Handle final submit (Tab 2 Submit button)
            form.on("submit", function (e) {
                form.validate().settings.ignore = "";

                if (!form.valid()) {
                    e.preventDefault();

                    // Jump to the first invalid tab
                    var firstError = form.find(".input-validation-error").first();
                    if (firstError.length) {
                        var tabId = firstError.closest(".tab-pane").attr("id");
                        $('button[data-bs-target="#' + tabId + '"]').tab("show");
                    }
                }
            });
        });

        $(document).ready(function () {
            $("#CustomerKycForm").submit(function (e) {
                e.preventDefault();

                // check if form is valid client-side
                if (!$(this).valid()) {
                    return false;
                }

                var formData = new FormData(this);

                $.ajax({
                    url: $(this).attr("action"),
                    type: $(this).attr("method"),
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                           showToast(response)
                            window.location.href = "/Home/Success";
                           form.reset();
                        } else {
							showToast(response);
                        }
                    },
                    error: function (xhr) {
                        // parse model validation errors if any
                        if (xhr.responseJSON) {
                            let errors = [];
                            for (var key in xhr.responseJSON) {
                                errors.push(xhr.responseJSON[key].join("<br/>"));
                            }
                            $("#formResult").html(
                                '<div class="alert alert-danger">' + errors.join("<br/>") + '</div>'
                            );
                        } else {
                            $("#formResult").html(
                                '<div class="alert alert-danger">Server error occurred.</div>'
                            );
                        }
                    }
                });
            });
        });

       

    </script>
}