<div class="container my-4">
    <div class="row">
        <div class="col-xxl-6 offset-xxl-3">
            <div class="payment-container p-4 border rounded bg-white">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="merchant-name fw-bold">ACME</span>
                    <span class="payment-amount fw-bold text-dark">£12.00</span>
                </div>

                <!-- Change Payment Method -->
                <a href="#" class="d-inline-flex align-items-center mb-3 text-primary text-decoration-none">
                    <i class="ri-arrow-left-s-line me-1"></i>
                    CHANGE PAYMENT METHOD
                </a>

                <div class="text-danger mb-3 small">*Required Fields</div>

                <!-- Payment Form -->
                <form class="payment-form">
                    <!-- Card Details -->
                    <div class="form-section mb-4">
                        <div class="section-header">
                            <h3>Pay online securely</h3>
                            <i class="ri-lock-fill"></i>
                        </div>

                        <!-- Card Number -->
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label">Card Number*</label>
                            <div class="form-icon">
                                <input type="number" class="form-control form-control-icon" id="iconInput" placeholder="5555 5555 5555 4444">
                                <i class="ri-bank-card-fill"></i>
                            </div>
                        </div>

                        @* <div class="form-group"> 
                            <label for="cardNumber" class="form-label">Card Number</label>
                            <div class="form-icon"> 
                                <input type="number" class="form-control form-control-icon" id="iconInput" placeholder="424242424242424242"> 
                                <i class="ri-bank-card-fill"></i> 
                            </div> 
                        </div> *@

                        <!-- Name on Card -->
                        <div class="mb-3">
                            <label for="cardName" class="form-label">Name on Card*</label>
                            <input type="text" class="form-control" id="cardName" placeholder="John Doe">
                        </div>

                        <!-- Expiry + CVV -->
                        <div class="row g-3">
                            <div class="col-6">
                                <label for="expiryDate" class="form-label">Expiry Date*</label>
                                <input type="text" class="form-control" id="expiryDate" placeholder="MM/YY" maxlength="5">
                            </div>
                            <div class="col-6">
                                <label for="securityCode" class="form-label">Security Code*</label>
                                <div class="form-icon">
                                    <input type="number" class="form-control form-control-icon" id="securityCode" placeholder="123" maxlength="4">
                                    <i class="ri-question-line"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Address -->
                    <div class="form-section mb-4">
                        <h3>Billing address</h3>
                        <div class="address-display">
                            <p class="mb-0">Address Line 1</p>
                            <p class="mb-0">Address Line 2</p>
                            <p class="mb-0">Town/City</p>
                            <p class="mb-0">County</p>
                            <p class="mb-0">Postcode</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm btn-edit">EDIT</button>
                    </div>

                    <!-- Pay Button -->
                    <button type="submit" class="btn btn-primary btn-pay">
                        <i class="ri-lock-fill me-1"></i>
                        PAY £12.00
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<div style="margin-top:20px; display:flex; justify-content:flex-end;">
    <button id="checkoutBtn"
            style="padding:10px 20px; border-radius:8px; border:none; background:#fff; color:#007bff; font-weight:bold; box-shadow:0 2px 5px rgba(0,0,0,0.2); cursor:pointer;">
        Next
    </button>
</div>
<style>
    /* Material-style input */
    .form-control {
        border: none;
        border-bottom: 2px solid #ccc;
        border-radius: 0;
        box-shadow: none;
        transition: all 0.3s ease-in-out;
        background: transparent;
    }

        .form-control:focus {
            border-bottom: 2px solid #0d6efd; /* Bootstrap primary color */
            box-shadow: none;
        }

    /* Label styling */
    .form-label {
        font-weight: 500;
        font-size: 0.9rem;
    }

    /* Icon inside input */
    .form-icon {
        position: relative;
    }

        .form-icon i {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #666;
        }

    /* Section headers */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

        .section-header h3 {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 600;
        }

    /* Buttons */
    .btn-pay {
        width: 100%;
        margin-top: 1.5rem;
        padding: 0.75rem;
        font-weight: bold;
    }

    .btn-edit {
        margin-top: 0.75rem;
        font-size: 0.875rem;
    }
</style>
