@model Poc.Infrastructure.DTOs.Customer.CustomerDetailDTO

@{
    ViewData["Title"] = "Customer Details";
}

<h2>Customer Details</h2>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4>Personal Information</h4>
    </div>
    <div class="card-body">
        <p><strong>First Name:</strong> @Model.FirstName</p>
        <p><strong>Last Name:</strong> @Model.LastName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Mobile:</strong> @Model.Mobile</p>
        <p><strong>Country:</strong> @Model.Country</p>
        <p><strong>State:</strong> @Model.State</p>
        <p><strong>City:</strong> @Model.City</p>
        <p><strong>Address:</strong> @Model.Address</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <h4>Business Information</h4>
    </div>
    <div class="card-body">
        <p><strong>Business Type:</strong> @Model.BusinessType</p>
        <p><strong>Business Country:</strong> @Model.BusinessCountry</p>
        <p><strong>Business State:</strong> @Model.BusinessState</p>
        <p><strong>Business City:</strong> @Model.BusinessCity</p>
        <p><strong>Business Address:</strong> @Model.BusinessAddress</p>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <h4>Proof of Business</h4>
    </div>
    <div class="card-body">
        @if (Model.ProofOfBusinesses != null && Model.ProofOfBusinesses.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>File</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proof in Model.ProofOfBusinesses)
                    {
                        <tr>
                            <td>@proof.Type</td>

                            <!-- ✅ File Show with View & Download -->
                            <td>
                                @if (!string.IsNullOrEmpty(proof.FileContent))
                                {
                                    var fileUrl = Url.Content($"~/assets/uploads/{proof.FileContent}");
                                    <div>
                                        <a href="@fileUrl" target="_blank" class="btn btn-sm btn-primary">
                                            View
                                        </a>
                                        <a href="@fileUrl" download class="btn btn-sm btn-success ms-2">
                                            Download
                                        </a>
                                        <span class="ms-2">@proof.FileContent</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">No File</span>
                                }
                            </td>
                            <td>
                                <span id="proof-status-@proof.Id.ToString()" class="badge
@(proof.Status == true ? "bg-success" : proof.Status == false ? "bg-danger" : "bg-secondary") fs-6">
                                    @(proof.Status == true ? "Approved" : proof.Status == false ? "Rejected" : "Pending")
                                </span>
                            </td>
                            <td>
                                <!-- ✅ Green Tick -->
                                <button class="btn btn-sm btn-light proof-status ms-2"
                                        data-id="@proof.Id.ToString()" data-status="true" title="Approve">
                                    <i class="bi bi-check-lg text-success fs-4"></i>
                                </button>

                                <!-- ❌ Red Cross -->
                                <button class="btn btn-sm btn-light proof-status ms-2"
                                        data-id="@proof.Id.ToString()" data-status="false" title="Reject">
                                    <i class="bi bi-x-lg text-danger fs-4"></i>
                                </button>
                            </td>





                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No Proof of Business available.</p>
        }
    </div>
</div>



<div class="card mb-4">
    <div class="card-header bg-warning text-dark">
        <h4>Proof of Business Activities</h4>
    </div>
    <div class="card-body">
        @if (Model.ProofOfBusinessesActivity != null && Model.ProofOfBusinessesActivity.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Modified By</th>
                        <th>Customer Id</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in Model.ProofOfBusinessesActivity)
                    {
                        <tr>
                            <td>@activity.Type</td>
                            <td>@activity.Reason</td>
                     @*        <td>@(activity.Status ? "Approved" : "Pending")</td> *@
                            <td>@(activity.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                            <td>@activity.ModifiedBy</td>
                            <td>@activity.CustomerId</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No Proof of Business Activities available.</p>
        }
    </div>
</div>


<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".proof-status").forEach(btn => {
            btn.addEventListener("click", function () {
                let proofId = this.getAttribute("data-id");
                let newStatus = this.getAttribute("data-status") === "true";
                let statusBadge = document.getElementById("proof-status-" + proofId);

                // ✅ Token
                let tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                let token = tokenElement ? tokenElement.value : "";

                fetch('/Customers/ToggleProofStatus', {   // 👈 yahan "Customers" ya "Customer" confirm karo
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        Id: proofId,
                        Status: newStatus
                    })
                })
                .then(res => {
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        if (newStatus) {
                            statusBadge.textContent = "Approved ✅";
                            statusBadge.className = "badge bg-success fs-6";
                        } else {
                            statusBadge.textContent = "Rejected ❌";
                            statusBadge.className = "badge bg-danger fs-6";
                        }
                    } else {
                        Swal.fire("Error!", data.message, "error");
                    }
                })
                .catch((err) => {
                    Swal.fire("Error!", "Request failed: " + err.message, "error");
                });
            });
        });
    });
</script>


