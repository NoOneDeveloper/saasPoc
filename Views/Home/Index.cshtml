@{
    ViewBag.Title = "Landing";
    Layout = null;
}

<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg">
<head>
    <partial name="~/Views/Shared/_title_meta.cshtml">
    <!--Swiper slider css-->
    <link href="~/assets/libs/swiper/swiper-bundle.min.css" rel="stylesheet" type="text/css" />
    <partial name="~/Views/Shared/_head_css.cshtml">
</head>
<body data-bs-spy="scroll" data-bs-target="#navbar-example">

    <!-- Begin page -->
    <div class="layout-wrapper landing">
        <div class="bg-overlay bg-overlay-pattern"></div>
        <!-- end navbar -->
        <!-- start hero section -->
        <section class="section nft-hero" id="hero">
            <div class="bg-overlay"></div>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 col-sm-10">
                        <div class="text-center">
                            <h1 class="display-4 fw-medium mb-4 lh-base text-white">Discover Digital Art & Collect <span class="text-success">Confidence in Every Payment</span></h1>
                            <p class="lead text-white-50 lh-base mb-4 pb-2">Can artwork be NFT? NFTs (non-fungible tokens) are one-of-a-kind digital assets. Given they're digital in nature, can physical works of art be turned into NFTs?.</p>

                            <div class="hstack gap-2 justify-content-center">
                                <a href="/Authentication/SignInBasic" class="btn btn-lg btn-outline-success rounded-pill"><i class="ri-login-circle-line align-middle me-2"></i> SIGN IN </a>
                                <a href="/Authentication/SignUpBasic" class="btn btn-lg btn-outline-danger rounded-pill"> <i class="ri-user-add-line align-middle me-2"></i> GET STARTED </a>
                            </div>
                        </div>
                    </div><!--end col-->
                </div><!-- end row -->
            </div><!-- end container -->
        </section><!-- end hero section -->
      
        <!-- Start footer -->
        <footer class="custom-footer bg-dark position-relative">
            <div class="container">
                <div class="row align-items-center text-center">
                    <!-- Logo -->
                    <div class="col-lg-4 my-3 d-flex justify-content-lg-start justify-content-center">
                        <img src="~/assets/images/logo-light.png" alt="logo light" height="40">
                    </div>

                    <!-- Links + Copyright -->
                    <div class="col-lg-8">
                        <div class="row justify-content-center">
                            <div class="col-sm-4 my-3">
                                <h5 class="mb-0 ff-secondary footer-list">
                                    <a class="text-white" href="/pages/ProfileSimple">About Us</a>
                                </h5>
                            </div>
                            <div class="col-sm-4 my-3">
                                <h5 class="mb-0 ff-secondary footer-list">
                                    <a class="text-white" href="/pages/ProfileSimple">Contact Us</a>
                                </h5>
                            </div>
                            <div class="col-sm-4 my-3 d-flex align-items-center justify-content-sm-start justify-content-center">
                                <p class="copy-rights mb-0 text-white">
                                    <script>document.write(new Date().getFullYear())</script> © Inovedia Technologies
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end footer -->

    </div>
    <!-- end layout wrapper -->
    <!-- end layout wrapper -->
    <partial name="~/Views/Shared/_vendor_scripts.cshtml">

    <!--Swiper slider js-->
    <script src="~/assets/libs/swiper/swiper-bundle.min.js"></script>

    <script src="~/assets/js/pages/nft-landing.init.js"></script>
</body>
</html>