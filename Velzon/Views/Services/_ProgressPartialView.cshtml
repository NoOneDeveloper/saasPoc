<!-- Payment Link Partial View -->
<div class="container">
    <div class="row">
        <div class="col-6 offset-3">

            <div class="card p-4">
                <div class="text-center">
                    <img src="@Url.Content("~/assets/images/logo-sm.png")" alt="Company Logo" height="50" />
                </div>
            </div>
            <!-- Logo Section -->

            <!-- Click to Pay -->
            <div class="text-center mb-4">
                <button type="button" class="btn btn-primary w-100 ">
                    <i class="fa fa-credit-card"></i> Click to Pay
                </button>
            </div>

            <!-- Send Link Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Send Link</h2>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="email" id="email" class="form-control ms-2" placeholder="Enter email address" />
                            <button type="button" class="btn btn-success ms-2">SEND</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="paymentLink" class="form-label">Payment Link</label>
                        <div class="input-group gap-2">
                            <input type="text" id="paymentLink" class="form-control" value="https://euwest1.pcipalstaging.cloud/digital/xXtwFn" readonly />
                            <button type="button" class="btn btn-outline-secondary">COPY</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer Progress -->
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Customer Progress</h2>
                    <ul class="list-group">
                        <li class="list-group-item">1. Link Opened</li>
                        <li class="list-group-item">2. Payment Method Chosen</li>
                        <li class="list-group-item">3. Payment Started</li>
                        <li class="list-group-item">4. Payment Result</li>
                    </ul>
                </div>
            </div>

            <!-- Cancel Button -->
            <div class="">
                <button type="button" class="btn btn-danger">CANCEL PAYMENT</button>
            </div>

        </div>
    </div>
</div>
