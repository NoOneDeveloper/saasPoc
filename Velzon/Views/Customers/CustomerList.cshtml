@using Poc.Infrastructure.DTOs.Customer
@using Poc.Infrastructure.DTOs.Global
@model Result<List<SignUpCustomersDTO>>

@{
    List<SignUpCustomersDTO>? customerList = Model.Data;
}

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Basic Datatables</h5>
            </div>
            <div class="card-body">
                @if (customerList != null)
                {
                    @if (customerList.Any())
                    {
                        <table id="example" class="table table-bordered dt-responsive nowrap table-striped align-middle" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                     @*                <th>Status</th> *@
                                    <th>Created At</th>
                                    <th>Detail</th>
                    @*                 <th class="text-center">Action</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (SignUpCustomersDTO customer in customerList)
                                {
                                    <tr>
                                        <td>@customer.FirstName @customer.LastName</td>
                                        <td>@customer.Email</td>
                                        <td>@customer.Phone</td>
                           @*              <td>
                                            <span id="status-badge-@customer.Id"
                                                  class="badge @(customer.Status ==true ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") badge-border">
                                                @(customer.Status ==true ? "Active" : "Inactive")
                                            </span>
                                        </td> *@
                                        <td>@customer.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("Details", "Customers", new { id = customer.Id })"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                   @*      <td class="d-flex justify-content-center">
                                            <div class="form-check form-switch form-switch-md mb-3" dir="ltr">
                                                <input type="checkbox"
                                                       class="form-check-input status-toggle"
                                                       data-id="@customer.Id"
                                                @(customer.Status==true ? "checked" : "") />
                                            </div>
                                        </td> *@
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else
                {
                    <div class="py-2 text-center">
                        <h5 class="mb-1">No Customers Found</h5>
                    </div>
                }
            </div>
        </div>
    </div><!--end col-->
</div><!--end row-->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".status-toggle").forEach(cb => {
            cb.addEventListener("change", function (e) {
                e.preventDefault();

                let checkbox = this;
                let customerId = checkbox.getAttribute("data-id");
                let badge = document.getElementById("status-badge-" + customerId);

                // Revert until confirm
                checkbox.checked = !checkbox.checked;

                Swal.fire({
                    title: "Are you sure?",
                    text: "Do you really want to change the status?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, change it!",
                    cancelButtonText: "No, cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        checkbox.checked = !checkbox.checked;

                        fetch('/Customers/ChangeStatus', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                Id: customerId,
                                status: checkbox.checked
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire("Updated!", "Status changed successfully.", "success");

                                // ✅ Badge update
                                if (checkbox.checked) {
                                    badge.textContent = "Active";
                                    badge.className = "badge bg-success-subtle text-success badge-border";
                                } else {
                                    badge.textContent = "Inactive";
                                    badge.className = "badge bg-danger-subtle text-danger badge-border";
                                }
                            } else {
                                Swal.fire("Error!", data.message, "error");
                                checkbox.checked = !checkbox.checked;
                            }
                        })
                        .catch(() => {
                            Swal.fire("Error!", "Request failed.", "error");
                            checkbox.checked = !checkbox.checked;
                        });
                    }
                });
            });
        });
    });
</script>
