@using Poc.Infrastructure.DTOs.Customer
@using Poc.Infrastructure.DTOs.Global
@model Result<List<CustomerKycDTO>>

@{
    List<CustomerKycDTO>? kycList = Model.Data;
    ViewData["Title"] = "Customer KYC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Customer KYC Records</h5>
            </div>
            <div class="card-body">
                @if (kycList != null && kycList.Any())
                {
                        <table id="kycTable" class="table table-bordered dt-responsive nowrap table-striped align-middle" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Country</th>
                                    <th>State</th>
                                    <th>City</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var customer in kycList)
                            {
                                        <tr>
                                            <td>@customer.Email</td>
                                            <td>@customer.Phone</td>
                                            <td>@customer.Country</td>
                                            <td>@customer.State</td>
                                            <td>@customer.City</td>
                                            <td>
                                                <span id="status-badge-@customer.UserId"
                                                      class="badge bg-success-subtle text-success badge-border">
                                                    Active
                                                </span>
                                            </td>
                                            <td class="d-flex justify-content-center">
                                                <div class="form-check form-switch form-switch-md mb-3" dir="ltr">
                                                    <input type="checkbox"
                                                           class="form-check-input status-toggle"
                                                           data-id="@customer.UserId"
                                                           checked />
                                                </div>
                                            </td>
                                        </tr>
                            }
                            </tbody>
                        </table>
                }
                else
                {
                        <div class="py-2 text-center">
                            <h5 class="mb-1">No KYC Records Found</h5>
                        </div>
                }
            </div>
        </div>
    </div><!--end col-->
</div><!--end row-->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".status-toggle").forEach(cb => {
            cb.addEventListener("change", function (e) {
                e.preventDefault();

                let checkbox = this;
                let userId = checkbox.getAttribute("data-id");
                let badge = document.getElementById("status-badge-" + userId);

                // Revert until confirm
                checkbox.checked = !checkbox.checked;

                Swal.fire({
                    title: "Are you sure?",
                    text: "Do you want to change this customer's status?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, change it!",
                    cancelButtonText: "No, cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        checkbox.checked = !checkbox.checked;

                        fetch('/CustomerKyc/ChangeStatus', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                Id: userId,
                                status: checkbox.checked
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire("Updated!", "Status changed successfully.", "success");

                                // ✅ Badge update
                                if (checkbox.checked) {
                                    badge.textContent = "Active";
                                    badge.className = "badge bg-success-subtle text-success badge-border";
                                } else {
                                    badge.textContent = "Inactive";
                                    badge.className = "badge bg-danger-subtle text-danger badge-border";
                                }
                            } else {
                                Swal.fire("Error!", data.message, "error");
                                checkbox.checked = !checkbox.checked;
                            }
                        })
                        .catch(() => {
                            Swal.fire("Error!", "Request failed.", "error");
                            checkbox.checked = !checkbox.checked;
                        });
                    }
                });
            });
        });
    });
</script>
