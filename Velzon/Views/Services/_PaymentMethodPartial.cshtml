@* Partial View: Payment Method *@
<div class="row justify-content-center">
    <div class="col-md-4">

        <!-- Logo Card -->
        <div class="card text-center mb-3 shadow-sm border-0">
            <div class="card-body">
                <img src="~/assets/images/logo-light.png" alt="Logo" height="50" class="mb-2">
               
            </div>
        </div>

        <!-- Payment Options Card -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center my-3">
                    <p class="mb-0 fw-bold">ACME</p>
                    <p class="mb-0 fs-5 fw-bold">£12.00</p>
                </div>
                <!-- Pay By Card -->
                <div class="border rounded p-3 mb-3 payment-option">
                    <span class="fw-bold">
                        <i class="fa fa-credit-card me-2"></i> Pay By Card
                    </span>
                    <p class="mb-0 small text-muted mt-1">
                        Use a credit or debit card for a secure, hassle free payment
                    </p>
                </div>

                <!-- Pay By Bank -->
                <div class="border rounded p-3 mb-3 payment-option">
                    <span class="fw-bold">
                        <i class="fa fa-university me-2"></i> Pay By Bank
                    </span>
                    <p class="mb-0 small text-muted mt-1">
                        Use your banking app for a secure payment, directly from your account
                    </p>
                </div>

                <!-- Checkout Button -->
                <div class="d-grid mt-3">
                    <button class="btn btn-primary fw-bold" disabled>
                        <i class="fa fa-lock me-2"></i> CONTINUE
                    </button>
                </div>
            </div>
        </div>

        <!-- Next Button -->
        <div class="d-flex justify-content-end">
            <button id="paymentNextBtn" class="btn btn-light text-primary fw-bold shadow-sm">
                Next
            </button>
        </div>

    </div>
</div>
